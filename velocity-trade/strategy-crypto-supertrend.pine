//@version=6
strategy("Crypto SuperTrend + 200 EMA", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

atrPeriod = input.int(10, "ATR Length")
factor = input.float(3.0, "Factor")
emaLength = input.int(200, "EMA Length")

[supertrend, direction] = ta.supertrend(factor, atrPeriod)
ema200 = ta.ema(close, emaLength)

// Only go long if above 200 EMA (Long-term Bullish Trend)
longCondition = ta.crossover(close, supertrend) and close > ema200
shortCondition = ta.crossunder(close, supertrend) and close < ema200

if (longCondition)
    strategy.entry("Long", strategy.long)
if (shortCondition)
    strategy.entry("Short", strategy.short)

plot(supertrend, "SuperTrend", color=direction < 0 ? color.green : color.red, style=plot.style_stepline, linewidth=2)
plot(ema200, "200 EMA", color=color.white, linewidth=2)
